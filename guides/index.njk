---
# guides.11tydata.json sets templateEngineOverride: md + layout: vault-guide.njk
# for the markdown guides in this dir. This listing overrides both back to the
# base layout as a Nunjucks template (mirrors blog/index.njk).
layout: base.njk
templateEngineOverride: njk
title: Guides
description: "Your vault's skill files — written for your AI first, readable by you. Seeded into every new Parachute vault."
permalink: /guides/
---
<main>
    <div class="roadmap-header fade-up fade-up-1">
        <h1>Guides</h1>
        <p class="dates">Your vault&rsquo;s skill files &mdash; written for your AI first (it reads them to learn how to work with your notes), but they&rsquo;re plain markdown, so they&rsquo;re a good read for you too. Every one also ships inside a new vault, tagged <code>#guide</code>.</p>
    </div>

    <section class="section fade-up fade-up-2">
        <ul class="blog-list">
            {%- for guide in collections.guides %}
            <li>
                <a href="{{ guide.url }}" class="blog-post-card">
                    <h3>{{ guide.data.title }}</h3>
                    {% if guide.data.description %}<p class="excerpt">{{ guide.data.description }}</p>{% endif %}
                </a>
            </li>
            {%- endfor %}
        </ul>
    </section>
</main>
