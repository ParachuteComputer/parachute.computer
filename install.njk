    {# Progressive enhancement only — the CSS-only picker above is fully
       functional without this. When a deep link or in-page anchor wants to
       jump to a specific path, this toggles the matching radio. Never
       required for the page to work. #}
    <script>
    (function () {
        var doRadio = document.getElementById("path-do");
        if (!doRadio) return;
        document.querySelectorAll(".switch-to-do").forEach(function (sw) {
            sw.addEventListener("click", function (e) {
                e.preventDefault();
                doRadio.checked = true;
                doRadio.scrollIntoView({ behavior: "smooth", block: "start" });
                doRadio.focus({ preventScroll: true });
            });
        });
    })();
    </script>

