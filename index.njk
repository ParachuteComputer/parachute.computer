    <!-- How It Works -->
    <section class="section">
        <h2>How it works</h2>
        <div class="architecture-diagram">
   Phone &middot; Web &middot; Pendant
              &darr;
       Parachute Daily
              &darr;
      Parachute Vault &mdash;&mdash;&mdash;&mdash; MCP &mdash;&mdash;&mdash;&mdash;&rarr; Claude &middot; ChatGPT &middot; Gemini
