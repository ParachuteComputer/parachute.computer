<style>
/* Landing — split hero, 2x2 body grid, principles row. */

.pl-hero {
    padding: 5rem 0 4rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 4rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
}
.pl-left h1 {
    font-family: var(--serif);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--fg);
    margin-bottom: 0.65rem;
}
.pl-subhead {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--fg-muted);
    margin: 0 0 1.75rem;
}
.pl-label {
    font-size: 0.72rem;
    color: var(--fg-dim);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 0.75rem;
    font-weight: 500;
}
.pl-problem-list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
}
.pl-problem-list li {
    color: #6E6A61;
    display: grid;
    grid-template-columns: 0.95rem 1fr;
    gap: 0.9rem;
    align-items: start;
    padding: 0.85rem 0;
    font-size: 0.95rem;
    line-height: 1.55;
    border-bottom: 1px solid var(--border);
}
.pl-problem-list li:last-child {
    border-bottom: none;
}
.pl-problem-icon {
    width: 1.05rem;
    height: 1.05rem;
    color: #6E6A61;
    flex: none;
    margin-top: 0.15rem;
}
.pl-problem-icon svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
}
.pl-right { padding-top: 0.25rem; }
.pl-product-name {
    font-family: var(--serif);
    font-size: 1.1rem;
    color: var(--accent);
    font-style: italic;
    margin-bottom: 0.5rem;
}
.pl-product-name .alpha-tag {
    top: -0.25em;
}
.pl-desc {
    color: var(--fg-muted);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 1rem;
}
.pl-desc:last-of-type { margin-bottom: 1.75rem; }
.pl-install-note {
    font-size: 0.83rem;
    color: var(--fg-dim);
    margin-top: 0.75rem;
    line-height: 1.6;
}
.pl-install-note a { color: var(--fg-muted); }
.pl-install-note a:hover { color: var(--accent); }
.pl-cta-btn {
    display: block;
    background: var(--accent);
    color: #fff;
    padding: 0.85rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    text-align: center;
    margin-top: 1.25rem;
    transition: background 0.2s ease, transform 0.15s ease;
    box-shadow: 0 1px 4px rgba(74, 124, 89, 0.15);
}
.pl-cta-btn:hover {
    background: var(--accent-hover);
    color: #fff;
    transform: translateY(-1px);
}
.pl-secondary-links {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--fg-dim);
}
.pl-secondary-links a { color: var(--fg-dim); }
.pl-secondary-links a:hover { color: var(--accent); }

/* 2x2 body grid */
.pl-grid-section {
    margin-bottom: 3rem;
}
.pl-grid-section > h2 {
    font-family: var(--serif);
    font-size: 1.35rem;
    font-weight: 400;
    margin-bottom: 1.2rem;
    color: var(--fg);
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--border);
}
.pl-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
}
.pl-cell {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.75rem 2rem;
    background: var(--card-bg);
}
.pl-cell-primary {
    padding: 1.95rem 2.1rem;
    box-shadow: 0 8px 24px rgba(44, 42, 38, 0.035);
}
.pl-cell-secondary {
    background: rgba(255, 255, 255, 0.78);
}
.pl-cell-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.95rem;
}
.pl-cell-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--accent);
    flex: none;
}
.pl-cell-secondary .pl-cell-icon {
    color: var(--fg-dim);
}
.pl-cell-icon svg {
    display: block;
    width: 100%;
    height: 100%;
    stroke: currentColor;
}
.pl-cell h2 {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--fg);
    line-height: 1.3;
    margin: 0;
}
.pl-cell p {
    color: var(--fg-muted);
    font-size: 0.92rem;
    line-height: 1.7;
    margin-bottom: 0.75rem;
}
.pl-cell p:last-child { margin-bottom: 0; }
.pl-tool-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0.85rem 0 0;
}
.pl-tool-chip {
    font-family: var(--mono);
    font-size: 0.76rem;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid rgba(74, 124, 89, 0.2);
    border-radius: 6px;
    padding: 0.2rem 0.6rem;
}

/* Notes callout — lightweight product module */
.pl-aside {
    max-width: 860px;
    margin: 0 auto 4rem;
    padding: 1.45rem 1.6rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: linear-gradient(180deg, rgba(243, 240, 234, 0.55) 0%, rgba(255, 255, 255, 0.92) 100%);
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(240px, 0.95fr);
    align-items: center;
    gap: 1.75rem;
}
.pl-aside-copy {
    flex: 1;
    min-width: 0;
}
.pl-aside-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-dim);
    margin-bottom: 0.7rem;
    font-weight: 500;
}
.pl-aside-eyebrow-icon {
    width: 0.9rem;
    height: 0.9rem;
    color: var(--accent);
    flex: none;
}
.pl-aside-eyebrow-icon svg {
    display: block;
    width: 100%;
    height: 100%;
    stroke: currentColor;
}
.pl-aside-lead {
    font-size: 1.2rem;
    line-height: 1.2;
    color: var(--fg);
    margin-bottom: 0.6rem;
    font-family: var(--serif);
    letter-spacing: -0.01em;
}
.pl-aside-body {
    font-size: 0.93rem;
    color: var(--fg-muted);
    line-height: 1.65;
    margin-bottom: 0.35rem;
    max-width: 34rem;
}
.pl-aside-body a {
    color: var(--accent);
}
.pl-aside-support {
    font-size: 0.88rem;
    color: var(--fg-dim);
    line-height: 1.55;
    margin-bottom: 0;
}
.pl-aside-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    gap: 0.7rem;
    min-width: 0;
}
.pl-aside-install {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    max-width: 100%;
}
.pl-aside-install code {
    background: var(--code-bg, rgba(0,0,0,0.04));
    padding: 0.08rem 0.3rem;
    border-radius: 4px;
    font-size: 0.85em;
}
.pl-aside-secondary {
    font-size: 0.88rem;
    color: var(--fg-muted);
    line-height: 1.5;
    text-align: right;
}
.pl-aside-secondary a {
    color: var(--fg-muted);
}
.pl-aside-secondary a:hover {
    color: var(--accent);
}

/* Principles row */
.pl-principles {
    margin-bottom: 4rem;
}
.pl-principles h2 {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 400;
    margin-bottom: 1.25rem;
    color: var(--fg);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
}
.pl-principles-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.15rem;
}
.pl-principle {
    padding: 1.2rem 1.25rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.58);
    transition: border-color 0.18s ease, transform 0.18s ease, background 0.18s ease;
}
.pl-principle:hover {
    border-color: #d8d2c7;
    background: rgba(255, 255, 255, 0.8);
    transform: translateY(-1px);
}
.pl-principle-icon {
    width: 1.35rem;
    height: 1.35rem;
    color: var(--fg-dim);
    margin-bottom: 0.95rem;
}
.pl-principle:nth-child(2) .pl-principle-icon,
.pl-principle:nth-child(4) .pl-principle-icon {
    width: 1.45rem;
}
.pl-principle-icon svg {
    display: block;
    width: 100%;
    height: 100%;
    stroke: currentColor;
}
.pl-principle strong {
    display: block;
    color: var(--fg);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    margin-bottom: 0.55rem;
}
.pl-principle span {
    display: block;
    color: var(--fg-muted);
    font-size: 0.84rem;
    line-height: 1.55;
    max-width: 12ch;
}

@media (max-width: 768px) {
    .pl-hero { grid-template-columns: 1fr; gap: 2.5rem; padding: 3rem 0 3rem; }
    .pl-grid { grid-template-columns: 1fr; }
    .pl-principles-grid { grid-template-columns: 1fr 1fr; }
    .pl-aside {
        grid-template-columns: 1fr;
        padding: 1.2rem 1.25rem;
    }
    .pl-aside-copy {
        margin-bottom: 0;
    }
    .pl-aside-actions {
        align-items: flex-start;
        justify-content: flex-start;
    }
    .pl-aside-secondary {
        text-align: left;
    }
}
@media (max-width: 480px) {
    .pl-principles-grid { grid-template-columns: 1fr; }
}
</style>

