<script>
/* Pitch deck controller.
   - Default mode: click prev/next or use arrow keys.
   - Live mode (when a real <video> is wired up): timeupdate drives the slide.
     Pausing the video flips into manual mode; play resumes auto-sync.
     Manual nav while video is playing pauses it (user takes the wheel).
   The video element is currently a placeholder div; once Aaron records,
   replace it with `<video class="pi-video" controls poster="...">...` and
   the script picks it up automatically. */
(function () {
    const slides = Array.from(document.querySelectorAll('.pi-deck .pi-slide'));
    if (slides.length === 0) return;

    const counter = document.querySelector('.pi-counter');
    const prev = document.querySelector('.pi-prev');
    const next = document.querySelector('.pi-next');
    const video = document.querySelector('video.pi-video');

    let current = 0;
    let manualMode = !video;

    // Allow ?s=N in the URL to deep-link to a slide (1-indexed).
    // Used for screenshot automation; harmless otherwise.
    const urlParams = new URLSearchParams(window.location.search);
    const initialSlideParam = parseInt(urlParams.get('s'), 10);
    const initialSlide = (Number.isFinite(initialSlideParam) && initialSlideParam >= 1 && initialSlideParam <= slides.length)
        ? initialSlideParam - 1
        : 0;

    function show(i) {
        if (i < 0 || i >= slides.length) return;
        slides[current].classList.remove('is-active');
        slides[i].classList.add('is-active');
        current = i;
        if (counter) counter.textContent = (i + 1) + ' / ' + slides.length;
        if (prev) prev.disabled = i === 0;
        if (next) next.disabled = i === slides.length - 1;
    }

    function takeManualControl() {
        manualMode = true;
        if (video && !video.paused) video.pause();
    }

    if (prev) prev.addEventListener('click', function () { takeManualControl(); show(current - 1); });
    if (next) next.addEventListener('click', function () { takeManualControl(); show(current + 1); });

    document.addEventListener('keydown', function (e) {
        const tag = e.target && e.target.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA') return;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
            takeManualControl();
            show(Math.min(current + 1, slides.length - 1));
            e.preventDefault();
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
            takeManualControl();
            show(Math.max(current - 1, 0));
            e.preventDefault();
        }
    });

    if (video) {
        video.addEventListener('play', function () { manualMode = false; });
        video.addEventListener('pause', function () { manualMode = true; });
        video.addEventListener('timeupdate', function () {
            if (manualMode) return;
            const t = video.currentTime;
            const idx = slides.findIndex(function (s) {
                const start = parseFloat(s.dataset.videoStart);
                const end = parseFloat(s.dataset.videoEnd);
                return !isNaN(start) && !isNaN(end) && t >= start && t < end;
            });
            if (idx >= 0 && idx !== current) show(idx);
        });
    }

    show(initialSlide);
})();

/* Floating video widget — collapsed/expanded toggle.
   Click anywhere on the toggle bar (button, icon, or close ×) flips state. */
(function () {
    const widget = document.querySelector('.pi-video-widget');
    if (!widget) return;
    const toggle = widget.querySelector('.pi-video-toggle');
    if (!toggle) return;
    toggle.addEventListener('click', function () {
        const expanded = widget.dataset.state === 'expanded';
        widget.dataset.state = expanded ? 'collapsed' : 'expanded';
        toggle.setAttribute('aria-expanded', String(!expanded));
    });
})();

/* Speaker notes — off by default. Click the button or press N to toggle.
   CSS gates .pi-notes visibility on the deck's data-notes attribute. */
(function () {
    const deck = document.querySelector('.pi-deck');
    const btn = document.querySelector('.pi-notes-toggle');
    if (!deck) return;
    function setNotes(on) {
        deck.dataset.notes = on ? 'on' : 'off';
        if (btn) {
            btn.setAttribute('aria-pressed', String(on));
            btn.textContent = on ? 'Hide notes' : 'Notes';
        }
    }
    setNotes(new URLSearchParams(window.location.search).get('notes') === 'on');
    if (btn) btn.addEventListener('click', function () {
        setNotes(deck.dataset.notes !== 'on');
    });
    document.addEventListener('keydown', function (e) {
        const tag = e.target && e.target.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA') return;
        if (e.key === 'n' || e.key === 'N') {
            setNotes(deck.dataset.notes !== 'on');
            e.preventDefault();
        }
    });
})();
</script>
