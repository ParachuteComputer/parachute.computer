    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fg-dim);
    font-family: var(--mono);
    font-size: 0.78rem;
    text-align: center;
    padding: 1rem 1.5rem;
    line-height: 1.6;
}

/* Module grid (What ships today) */
.pi-modules {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
    margin-top: 0.5rem;
}
.pi-mod {
    border: 1px solid var(--border);
