}

/* Team */
.pi-team {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 0.5rem;
}
.pi-person {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.2rem 1.35rem;
    background: var(--card-bg);
