/* Soft ask */
.pi-ask {
    margin-top: 0;
    padding: 2rem 2rem 2.25rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: linear-gradient(180deg, var(--bg-soft) 0%, var(--card-bg) 100%);
}
.pi-ask-quote {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
    line-height: 1.3;
    color: var(--fg);
    margin-bottom: 1.5rem;
    max-width: 36rem;
    letter-spacing: -0.015em;
}
.pi-ask-links {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.95rem;
    color: var(--fg-muted);
}
.pi-ask-links a {
    color: var(--accent);
}
.pi-ask-links .pi-ask-label {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-dim);
    margin-right: 0.6rem;
}

/* ── Presentation mode: viewport-bounded slides ──
   Activates when there's enough room to behave like a real slide deck:
   desktop width + at least ~600px of vertical space. The slide is locked
   to the viewport, content is tightened, speaker notes become a bottom
   drawer rather than pushing the slide off-screen.

   Below this threshold (phones, short windows, tablets in portrait) the
   default natural-flow rules above still apply — the deck just scrolls. */
@media (min-width: 901px) and (min-height: 600px) {
    .pi-page {
        max-width: 1080px;
        padding: 1.25rem 1.5rem 1.25rem;
    }

    /* Lock the active slide to the viewport.
       The :first-child / single-slide pattern means we can target .pi-slide
       directly: only one slide is .is-active at a time, and the rest are
       display:none. So height applies cleanly. */
    .pi-deck .pi-slide {
        min-height: 0;
        height: calc(100vh - var(--pi-nav-h) - var(--pi-deck-chrome));
        padding: 2.5rem 2.5rem 2rem;
        overflow: hidden;
    }
    .pi-deck .pi-slide.is-active {
        display: flex;
        flex-direction: column;
    }

    /* Tighter headings + lede so they don't dominate the frame. */
    .pi-deck .pi-slide .pi-h1 {
        font-size: clamp(2rem, 3.6vw, 2.8rem);
        margin-bottom: 0.8rem;
    }
    .pi-deck .pi-slide .pi-h2 {
        font-size: clamp(1.45rem, 2.4vw, 1.9rem);
        margin-bottom: 0.85rem;
    }
    .pi-deck .pi-slide .pi-lede {
        font-size: 1.05rem;
        line-height: 1.45;
        margin-bottom: 0.9rem;
    }
    .pi-deck .pi-slide .pi-label,
    .pi-deck .pi-slide .pi-eyebrow {
        margin-bottom: 0.75rem;
    }

    /* Images: cap their height so they don't blow out the slide.
       The .pi-img wrapper carries no chrome in deck mode and centers
       the image. Heights are set directly on the <img> so the constraint
       actually applies — `max-height: 100%` on the inner img requires the
       parent to have an explicit height, which we don't have here. */
    .pi-deck .pi-slide .pi-img {
        margin: 0.6rem 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: 0;
    }
    .pi-deck .pi-slide .pi-img picture {
        display: inline-block;
        max-width: 100%;
    }
    .pi-deck .pi-slide .pi-img img {
        max-height: 38vh;
        height: auto;
        width: auto;
        max-width: 100%;
        object-fit: contain;
    }
    .pi-deck .pi-slide .pi-img-caption {
        margin-top: 0.35rem;
        font-size: 0.72rem;
    }

    /* Slide-specific image sizing — slide 1 hero and slide 4 substrate diagram
       use two-column layouts at desktop so the image gets its own half of the
       slide rather than being sandwiched below text. Slide 8 pendant gallery
       gets a fixed cell height so the three images render as a uniform strip
       (was tiny + ragged because the portrait shot collapsed). */

    /* Slide 1 — hero. Text in column 1, image fills column 2 at large size. */
    .pi-deck .pi-slide.pi-hero.is-active {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
        grid-template-rows: auto auto auto;
        column-gap: 3rem;
        row-gap: 0.4rem;
        align-content: center;
        /* Reset the `justify-content: center` that `pi-slide-center` sets for
           flex layout — harmless today since the `fr` tracks absorb leftover
           space, but documents intent if columns ever become fixed-width. */
        justify-content: normal;
    }
