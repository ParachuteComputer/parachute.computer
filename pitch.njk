<style>
/* Pitch v4 — single full-width deck + floating corner video widget.
   Investor-readable as a click-through; "N" toggles speaker notes for depth. */

.pi-page {
    max-width: 920px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
}

/* ── Presentation-mode chrome bookkeeping ──
   Sticky header is ~67px. The deck reserves space for prev/notes/next
   controls + hint below each slide. We compute slide height from those. */
:root {
    --pi-nav-h: 67px;
    --pi-deck-chrome: 8.5rem; /* page padding + controls + hint, in deck mode */
}

/* ── Floating corner video widget ──
   Collapsed: a small "▶ Watch pitch" button anchored bottom-right.
   Expanded: the video panel slides up. Dismiss = back to collapsed.
   When a real <video class="pi-video"> is dropped in, the deck script
   advances slides via timeupdate while the video is playing. */
.pi-video-widget {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 50;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 8px 32px rgba(44, 42, 38, 0.14);
    overflow: hidden;
    transition: width 0.2s ease, box-shadow 0.2s ease;
}
.pi-video-widget[data-state="collapsed"] .pi-video-panel {
    display: none;
}
.pi-video-widget[data-state="expanded"] {
    width: 380px;
    box-shadow: 0 12px 40px rgba(44, 42, 38, 0.2);
}

.pi-video-toggle {
    width: 100%;
    background: transparent;
    border: 0;
    padding: 0.7rem 1.1rem;
    cursor: pointer;
    color: var(--fg);
    font: inherit;
    font-size: 0.88rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    line-height: 1.3;
}
.pi-video-toggle:hover {
    background: var(--bg-soft);
}
.pi-video-toggle-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
}
.pi-video-toggle-icon {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.pi-video-toggle-icon svg {
    width: 10px;
    height: 10px;
    fill: currentColor;
    margin-left: 1px;
}
.pi-video-duration {
    color: var(--fg-muted);
    font-size: 0.78rem;
    font-family: var(--mono);
}
.pi-video-toggle-close {
    color: var(--fg-muted);
    font-size: 1.1rem;
    line-height: 1;
}
.pi-video-widget[data-state="collapsed"] .pi-video-toggle-close { display: none; }
.pi-video-widget[data-state="expanded"] .pi-video-toggle-icon,
.pi-video-widget[data-state="expanded"] .pi-video-duration { display: none; }

/* ── Video panel (expanded) ── */
.pi-video-panel {
    border-top: 1px solid var(--border);
}
.pi-video-frame {
    aspect-ratio: 16 / 10;
    background: linear-gradient(135deg, var(--bg-soft) 0%, #ece7dd 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    color: var(--fg-muted);
}
.pi-video-play {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(74, 124, 89, 0.3);
}
.pi-video-play svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
    margin-left: 3px;
}
.pi-video-label {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-dim);
}
.pi-video-meta {
    padding: 0.85rem 1.1rem;
    border-top: 1px solid var(--border);
    font-size: 0.78rem;
    color: var(--fg-muted);
    line-height: 1.5;
}

@media (max-width: 700px) {
    .pi-video-widget {
        bottom: 0.75rem;
        right: 0.75rem;
    }
    .pi-video-widget[data-state="expanded"] {
        left: 0.75rem;
        width: auto;
    }
}

/* ── Deck column ──
   Only the active slide is shown; prev/next + keyboard arrows step through.
   When a real <video> is wired up, video timeupdate drives slide changes
   (data-video-start / data-video-end on each slide). Pause = manual mode.

   Each slide is its own framed surface — same min-height, same padding,
   same border, same slide-N indicator top-right. Flipping through the deck
   feels like flipping through slides, not scrolling through sections. */
.pi-deck { counter-reset: slide-num; }
.pi-deck .pi-slide {
    counter-increment: slide-num;
    display: none;
    position: relative;
    min-height: 68vh;
    padding: 3.5rem 2.75rem 3rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--card-bg);
    box-shadow: 0 1px 3px rgba(44, 42, 38, 0.04);
    box-sizing: border-box;
}
.pi-deck .pi-slide.is-active {
    display: flex;
    flex-direction: column;
}
.pi-deck .pi-slide::after {
    /* Use the slide's data-id rather than a CSS counter — CSS counters
       only increment on elements that generate a box, and inactive slides
       are `display: none`, so a counter shows the wrong number. */
    content: attr(data-slide-id) " / 10";
    position: absolute;
    top: 1.5rem;
    right: 1.75rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--fg-dim);
}
/* Short-content slides (hero, ask) center their content in the frame
   so the deck doesn't feel collapsed at the top. */
.pi-deck .pi-slide.pi-slide-center.is-active {
    justify-content: center;
}
@media (max-width: 700px) {
    .pi-deck .pi-slide {
        min-height: auto;
        padding: 2.5rem 1.5rem 2rem;
        border-radius: 10px;
    }
    .pi-deck .pi-slide::after {
        top: 1rem;
        right: 1.1rem;
    }
}

.pi-deck-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    gap: 1rem;
}
.pi-deck-controls button {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.5rem 1.1rem;
    font: inherit;
    font-size: 0.9rem;
    color: var(--fg);
    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
}
.pi-deck-controls button:hover:not(:disabled) {
    background: var(--bg-soft);
    border-color: var(--accent);
    color: var(--accent);
}
.pi-deck-controls button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
}
.pi-notes-toggle[aria-pressed="true"] {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent);
}

/* ── Speaker notes ──
   Hidden by default. Toggle from deck controls or press "N".
   Visible only when the deck container carries data-notes="on".
   The slide-level prose stays terse; long prose lives here. */
.pi-notes {
    display: none;
    margin-top: 1.75rem;
    padding: 1.1rem 1.4rem;
    border-left: 3px solid var(--accent);
    background: var(--bg-soft);
    border-radius: 0 8px 8px 0;
    color: var(--fg-muted);
    font-size: 0.92rem;
    line-height: 1.7;
}
.pi-notes::before {
    content: "Speaker notes";
    display: block;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-dim);
    margin-bottom: 0.55rem;
}
.pi-notes p {
    margin: 0 0 0.8rem;
    max-width: 36rem;
}
.pi-notes p:last-child { margin: 0; }
.pi-notes strong {
    color: var(--fg);
    font-weight: 500;
}
.pi-notes em { font-style: italic; }
.pi-notes a { color: var(--accent); }
.pi-deck[data-notes="on"] .pi-slide.is-active .pi-notes {
    display: block;
}
/* Counter in the controls bar is visually hidden — the in-frame ::after
   indicator is the primary surface — but kept in the DOM as a polite
   live region so screen readers still hear "slide N of 10" on change. */
.pi-counter {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}
.pi-deck-hint {
    margin-top: 0.85rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--fg-muted);
    text-align: center;
    letter-spacing: 0.04em;
}
@media (max-width: 900px) {
    .pi-deck-hint {
        display: none;
    }
}

.pi-eyebrow {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-dim);
    margin-bottom: 1.25rem;
}
.pi-label {
    display: inline-block;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 1.25rem;
}

.pi-h1 {
    font-family: var(--serif);
    font-size: clamp(2.4rem, 4.4vw, 3.4rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--fg);
    margin-bottom: 1rem;
}
.pi-h1 em {
    font-style: italic;
    color: var(--fg-muted);
}
.pi-h2 {
    font-family: var(--serif);
    font-size: clamp(1.7rem, 2.8vw, 2.25rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: var(--fg);
    margin-bottom: 1.4rem;
}
.pi-h2 em {
    font-style: italic;
    color: var(--fg-muted);
}
.pi-lede {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--fg-muted);
    margin-bottom: 1.5rem;
    max-width: 32rem;
}

.pi-prose {
    color: var(--fg-muted);
    font-size: 1rem;
    line-height: 1.75;
}
.pi-prose p {
    margin-bottom: 1rem;
    max-width: 36rem;
}
.pi-prose p:last-child { margin-bottom: 0; }
.pi-prose strong {
    color: var(--fg);
    font-weight: 500;
}
.pi-prose code {
    font-family: var(--mono);
    font-size: 0.88em;
    background: var(--bg-soft);
    padding: 0.08em 0.35em;
    border-radius: 4px;
    color: var(--fg);
}

/* Image inside a section */
.pi-img {
    margin: 1.5rem 0;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-soft);
}
.pi-img img {
    display: block;
    width: 100%;
    height: auto;
}
.pi-img-caption {
    font-size: 0.78rem;
    color: var(--fg-dim);
    line-height: 1.55;
    margin-top: 0.5rem;
    font-style: italic;
}
.pi-img-placeholder {
    aspect-ratio: 16 / 9;
    background: repeating-linear-gradient(
        45deg,
        var(--bg-soft),
        var(--bg-soft) 12px,
        rgba(0,0,0,0.02) 12px,
        rgba(0,0,0,0.02) 24px
    );
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fg-dim);
    font-family: var(--mono);
    font-size: 0.78rem;
    text-align: center;
    padding: 1rem 1.5rem;
    line-height: 1.6;
}

/* Module grid (What ships today) */
.pi-modules {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
    margin-top: 0.5rem;
}
.pi-mod {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.2rem 1.35rem;
    background: var(--card-bg);
}
.pi-mod-tag {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.6rem;
}
.pi-mod-tag.exploration {
    color: var(--fg-dim);
    background: var(--bg-soft);
}
.pi-mod h3 {
    font-family: var(--serif);
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--fg);
    margin: 0 0 0.35rem;
}
.pi-shipped-stamp {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.55);
    font-family: var(--mono);
    font-size: 0.74rem;
    line-height: 1.6;
    color: var(--fg-dim);
    letter-spacing: 0.01em;
}
.pi-shipped-stamp strong {
    color: var(--accent);
    font-weight: 500;
}
.pi-mod p {
    font-size: 0.88rem;
    color: var(--fg-muted);
    line-height: 1.55;
    margin: 0;
}

/* Flywheel diagram fallback (simple list with role-orbit framing) */
.pi-flywheel {
    margin-top: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--card-bg);
    overflow: hidden;
}
.pi-flywheel-row {
    padding: 1rem 1.4rem;
    border-bottom: 1px solid var(--border);
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1.25rem;
    align-items: baseline;
}
.pi-flywheel-row:last-child { border-bottom: none; }
.pi-flywheel-role {
    font-family: var(--serif);
    font-size: 1.05rem;
    color: var(--accent);
}
.pi-flywheel-body {
    color: var(--fg-muted);
    font-size: 0.92rem;
    line-height: 1.6;
}
.pi-flywheel-body strong {
    color: var(--fg);
    font-weight: 500;
}

/* Tier table */
.pi-tiers {
    margin-top: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--card-bg);
}
.pi-tier {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1.25rem;
    align-items: baseline;
    padding: 0.95rem 1.25rem;
    border-bottom: 1px solid var(--border);
}
.pi-tier:last-child { border-bottom: none; }
.pi-tier.featured { background: var(--accent-soft); }
.pi-tier-price {
    font-family: var(--serif);
    font-size: 1.3rem;
    color: var(--accent);
    line-height: 1;
}
.pi-tier-price span {
    font-family: var(--sans);
    font-size: 0.7rem;
    color: var(--fg-dim);
}
.pi-tier-body {
    color: var(--fg-muted);
    font-size: 0.92rem;
    line-height: 1.55;
}
.pi-tier-body strong { color: var(--fg); font-weight: 500; }

/* Future cards */
.pi-future {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 0.5rem;
}
.pi-future-card {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.2rem 1.4rem;
    background: var(--card-bg);
}
.pi-future-card strong {
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 400;
    color: var(--fg);
    display: block;
    margin-bottom: 0.4rem;
}
.pi-future-card span {
    color: var(--fg-muted);
    font-size: 0.88rem;
    line-height: 1.6;
    display: block;
}

/* Pendant gallery */
.pi-pendant-gallery {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0.75rem;
    margin: 1.5rem 0;
}
.pi-pendant-gallery .pi-img {
    margin: 0;
}

/* Team */
.pi-team {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 0.5rem;
}
.pi-person {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.2rem 1.35rem;
    background: var(--card-bg);
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 1rem;
    align-items: start;
}
.pi-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--serif);
    font-size: 0.65rem;
    color: var(--fg-dim);
    text-align: center;
    flex-shrink: 0;
}
.pi-person-body strong {
    font-family: var(--serif);
    font-size: 1.05rem;
    color: var(--fg);
    font-weight: 400;
    display: block;
    margin-bottom: 0.15rem;
}
.pi-person-body span {
    display: block;
    font-size: 0.82rem;
    color: var(--fg-muted);
    line-height: 1.55;
}
.pi-person-role {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.35rem;
    display: block;
}

/* Soft ask */
.pi-ask {
    margin-top: 0;
    padding: 2rem 2rem 2.25rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: linear-gradient(180deg, var(--bg-soft) 0%, var(--card-bg) 100%);
}
.pi-ask-quote {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
    line-height: 1.3;
    color: var(--fg);
    margin-bottom: 1.5rem;
    max-width: 36rem;
    letter-spacing: -0.015em;
}
.pi-ask-links {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.95rem;
    color: var(--fg-muted);
}
.pi-ask-links a {
    color: var(--accent);
}
.pi-ask-links .pi-ask-label {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-dim);
    margin-right: 0.6rem;
}

/* ── Presentation mode: viewport-bounded slides ──
   Activates when there's enough room to behave like a real slide deck:
   desktop width + at least ~600px of vertical space. The slide is locked
   to the viewport, content is tightened, speaker notes become a bottom
   drawer rather than pushing the slide off-screen.

   Below this threshold (phones, short windows, tablets in portrait) the
   default natural-flow rules above still apply — the deck just scrolls. */
@media (min-width: 901px) and (min-height: 600px) {
    .pi-page {
        max-width: 1080px;
        padding: 1.25rem 1.5rem 1.25rem;
    }

    /* Lock the active slide to the viewport.
       The :first-child / single-slide pattern means we can target .pi-slide
       directly: only one slide is .is-active at a time, and the rest are
       display:none. So height applies cleanly. */
    .pi-deck .pi-slide {
        min-height: 0;
        height: calc(100vh - var(--pi-nav-h) - var(--pi-deck-chrome));
        padding: 2.5rem 2.5rem 2rem;
        overflow: hidden;
    }
    .pi-deck .pi-slide.is-active {
        display: flex;
        flex-direction: column;
    }

    /* Tighter headings + lede so they don't dominate the frame. */
    .pi-deck .pi-slide .pi-h1 {
        font-size: clamp(2rem, 3.6vw, 2.8rem);
        margin-bottom: 0.8rem;
    }
    .pi-deck .pi-slide .pi-h2 {
        font-size: clamp(1.45rem, 2.4vw, 1.9rem);
        margin-bottom: 0.85rem;
    }
    .pi-deck .pi-slide .pi-lede {
        font-size: 1.05rem;
        line-height: 1.45;
        margin-bottom: 0.9rem;
    }
    .pi-deck .pi-slide .pi-label,
    .pi-deck .pi-slide .pi-eyebrow {
        margin-bottom: 0.75rem;
    }

    /* Images: cap their height so they don't blow out the slide.
       The .pi-img wrapper carries no chrome in deck mode and centers
       the image. Heights are set directly on the <img> so the constraint
       actually applies — `max-height: 100%` on the inner img requires the
       parent to have an explicit height, which we don't have here. */
    .pi-deck .pi-slide .pi-img {
        margin: 0.6rem 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: 0;
    }
    .pi-deck .pi-slide .pi-img picture {
        display: inline-block;
        max-width: 100%;
    }
    .pi-deck .pi-slide .pi-img img {
        max-height: 38vh;
        height: auto;
        width: auto;
        max-width: 100%;
        object-fit: contain;
    }
    .pi-deck .pi-slide .pi-img-caption {
        margin-top: 0.35rem;
        font-size: 0.72rem;
    }

    /* Slide-specific image sizing — hero gets the most room; in-content
       diagrams are smaller; the pendant strip on slide 8 is tiny. */
    .pi-deck .pi-slide.pi-hero .pi-img img { max-height: 42vh; }
    .pi-deck .pi-slide[data-slide-id="4"] .pi-img img { max-height: 18vh; }
    .pi-deck .pi-slide[data-slide-id="4"] .pi-img { margin: 0.25rem 0; }
    .pi-deck .pi-slide[data-slide-id="4"] .pi-img-caption { display: none; }
    .pi-deck .pi-slide[data-slide-id="4"] .pi-h2 { margin-bottom: 0.5rem; }
    .pi-deck .pi-slide[data-slide-id="8"] .pi-pendant-gallery { margin: 0.5rem 0 0.3rem; }
    .pi-deck .pi-slide[data-slide-id="8"] .pi-pendant-gallery .pi-img {
