}
.pi-img-caption {
    font-size: 0.78rem;
    color: var(--fg-dim);
    line-height: 1.55;
    margin-top: 0.5rem;
    font-style: italic;
}
.pi-img-placeholder {
    aspect-ratio: 16 / 9;
    background: repeating-linear-gradient(
        45deg,
        var(--bg-soft),
        var(--bg-soft) 12px,
        rgba(0,0,0,0.02) 12px,
        rgba(0,0,0,0.02) 24px
