<style>
/* Pitch v4 — single full-width deck + floating corner video widget.
   Investor-readable as a click-through; "N" toggles speaker notes for depth. */

.pi-page {
    max-width: 920px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
}

/* ── Presentation-mode chrome bookkeeping ──
   Sticky header is ~67px. The deck reserves space for prev/notes/next
   controls + hint below each slide. We compute slide height from those. */
:root {
    --pi-nav-h: 67px;
    --pi-deck-chrome: 8.5rem; /* page padding + controls + hint, in deck mode */
}

/* ── Floating corner video widget ──
   Collapsed: a small "▶ Watch pitch" button anchored bottom-right.
   Expanded: the video panel slides up. Dismiss = back to collapsed.
   When a real <video class="pi-video"> is dropped in, the deck script
   advances slides via timeupdate while the video is playing. */
.pi-video-widget {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 50;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 8px 32px rgba(44, 42, 38, 0.14);
    overflow: hidden;
    transition: width 0.2s ease, box-shadow 0.2s ease;
}
.pi-video-widget[data-state="collapsed"] .pi-video-panel {
    display: none;
}
.pi-video-widget[data-state="expanded"] {
    width: 380px;
    box-shadow: 0 12px 40px rgba(44, 42, 38, 0.2);
}

.pi-video-toggle {
    width: 100%;
    background: transparent;
    border: 0;
    padding: 0.7rem 1.1rem;
    cursor: pointer;
    color: var(--fg);
    font: inherit;
    font-size: 0.88rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    line-height: 1.3;
}
.pi-video-toggle:hover {
    background: var(--bg-soft);
}
.pi-video-toggle-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
}
.pi-video-toggle-icon {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.pi-video-toggle-icon svg {
    width: 10px;
    height: 10px;
    fill: currentColor;
    margin-left: 1px;
}
.pi-video-duration {
    color: var(--fg-muted);
    font-size: 0.78rem;
    font-family: var(--mono);
}
.pi-video-toggle-close {
    color: var(--fg-muted);
    font-size: 1.1rem;
    line-height: 1;
}
.pi-video-widget[data-state="collapsed"] .pi-video-toggle-close { display: none; }
.pi-video-widget[data-state="expanded"] .pi-video-toggle-icon,
.pi-video-widget[data-state="expanded"] .pi-video-duration { display: none; }

/* ── Video panel (expanded) ── */
.pi-video-panel {
    border-top: 1px solid var(--border);
}
.pi-video-frame {
    aspect-ratio: 16 / 10;
    background: linear-gradient(135deg, var(--bg-soft) 0%, #ece7dd 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    color: var(--fg-muted);
}
.pi-video-play {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(74, 124, 89, 0.3);
}
.pi-video-play svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
    margin-left: 3px;
}
.pi-video-label {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-dim);
}
.pi-video-meta {
    padding: 0.85rem 1.1rem;
    border-top: 1px solid var(--border);
    font-size: 0.78rem;
    color: var(--fg-muted);
    line-height: 1.5;
}

@media (max-width: 700px) {
    .pi-video-widget {
        bottom: 0.75rem;
        right: 0.75rem;
    }
    .pi-video-widget[data-state="expanded"] {
        left: 0.75rem;
        width: auto;
    }
}

/* ── Deck column ──
   Only the active slide is shown; prev/next + keyboard arrows step through.
   When a real <video> is wired up, video timeupdate drives slide changes
   (data-video-start / data-video-end on each slide). Pause = manual mode.

   Each slide is its own framed surface — same min-height, same padding,
   same border, same slide-N indicator top-right. Flipping through the deck
   feels like flipping through slides, not scrolling through sections. */
.pi-deck { counter-reset: slide-num; }
.pi-deck .pi-slide {
    counter-increment: slide-num;
    display: none;
    position: relative;
    min-height: 68vh;
    padding: 3.5rem 2.75rem 3rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--card-bg);
    box-shadow: 0 1px 3px rgba(44, 42, 38, 0.04);
    box-sizing: border-box;
}
.pi-deck .pi-slide.is-active {
    display: flex;
    flex-direction: column;
}
.pi-deck .pi-slide::after {
    /* Use the slide's data-id rather than a CSS counter — CSS counters
       only increment on elements that generate a box, and inactive slides
       are `display: none`, so a counter shows the wrong number. */
    content: attr(data-slide-id) " / 10";
    position: absolute;
    top: 1.5rem;
    right: 1.75rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--fg-dim);
}
/* Short-content slides (hero, ask) center their content in the frame
   so the deck doesn't feel collapsed at the top. */
.pi-deck .pi-slide.pi-slide-center.is-active {
    justify-content: center;
}
@media (max-width: 700px) {
    .pi-deck .pi-slide {
        min-height: auto;
        padding: 2.5rem 1.5rem 2rem;
        border-radius: 10px;
    }
    .pi-deck .pi-slide::after {
        top: 1rem;
        right: 1.1rem;
    }
}

.pi-deck-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    gap: 1rem;
}
.pi-deck-controls button {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.5rem 1.1rem;
    font: inherit;
    font-size: 0.9rem;
    color: var(--fg);
    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
}
.pi-deck-controls button:hover:not(:disabled) {
    background: var(--bg-soft);
    border-color: var(--accent);
    color: var(--accent);
}
.pi-deck-controls button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
}
.pi-notes-toggle[aria-pressed="true"] {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent);
}

/* ── Speaker notes ──
   Hidden by default. Toggle from deck controls or press "N".
   Visible only when the deck container carries data-notes="on".
   The slide-level prose stays terse; long prose lives here. */
.pi-notes {
    display: none;
    margin-top: 1.75rem;
    padding: 1.1rem 1.4rem;
    border-left: 3px solid var(--accent);
    background: var(--bg-soft);
    border-radius: 0 8px 8px 0;
    color: var(--fg-muted);
    font-size: 0.92rem;
    line-height: 1.7;
}
.pi-notes::before {
    content: "Speaker notes";
    display: block;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-dim);
    margin-bottom: 0.55rem;
}
.pi-notes p {
    margin: 0 0 0.8rem;
    max-width: 36rem;
}
.pi-notes p:last-child { margin: 0; }
.pi-notes strong {
    color: var(--fg);
    font-weight: 500;
}
.pi-notes em { font-style: italic; }
.pi-notes a { color: var(--accent); }
.pi-deck[data-notes="on"] .pi-slide.is-active .pi-notes {
    display: block;
}
/* Counter in the controls bar is visually hidden — the in-frame ::after
   indicator is the primary surface — but kept in the DOM as a polite
   live region so screen readers still hear "slide N of 10" on change. */
.pi-counter {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}
.pi-deck-hint {
    margin-top: 0.85rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--fg-muted);
    text-align: center;
    letter-spacing: 0.04em;
}
@media (max-width: 900px) {
    .pi-deck-hint {
        display: none;
    }
}

.pi-eyebrow {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-dim);
    margin-bottom: 1.25rem;
}
.pi-label {
    display: inline-block;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 1.25rem;
}

.pi-h1 {
    font-family: var(--serif);
    font-size: clamp(2.4rem, 4.4vw, 3.4rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--fg);
    margin-bottom: 1rem;
}
.pi-h1 em {
    font-style: italic;
    color: var(--fg-muted);
}
.pi-h2 {
    font-family: var(--serif);
    font-size: clamp(1.7rem, 2.8vw, 2.25rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: var(--fg);
    margin-bottom: 1.4rem;
}
.pi-h2 em {
    font-style: italic;
    color: var(--fg-muted);
}
.pi-lede {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--fg-muted);
    margin-bottom: 1.5rem;
    max-width: 32rem;
}

.pi-prose {
    color: var(--fg-muted);
    font-size: 1rem;
    line-height: 1.75;
}
.pi-prose p {
    margin-bottom: 1rem;
    max-width: 36rem;
}
.pi-prose p:last-child { margin-bottom: 0; }
.pi-prose strong {
    color: var(--fg);
    font-weight: 500;
}
.pi-prose code {
    font-family: var(--mono);
    font-size: 0.88em;
    background: var(--bg-soft);
    padding: 0.08em 0.35em;
    border-radius: 4px;
