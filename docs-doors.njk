---
# /docs/use/, /docs/build/, /docs/run/: one door's pages.
pagination:
  data: doorPages
  size: 1
  alias: d
permalink: "/docs/{{ d.door }}/"
layout: base.njk
eleventyExcludeFromCollections: true
eleventyComputed:
  title: "{{ d.title }}"
  door: "{{ d.door }}"
  description: "{{ d.who }}"
---
<main class="contents">
    <h1>{{ d.title }}</h1>
    <p class="lede">{{ d.who }}</p>
    <div class="doors one">
    <section><ol>
        {% for p in collections.docs | door(d.door) %}
        <li><div><a href="{{ p.url }}">{{ p.data.title }}</a><span>{{ p.data.summary | inlineCode | safe }}</span></div></li>
        {% endfor %}
    </ol></section>
    </div>
</main>
