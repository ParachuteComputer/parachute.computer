    border: 1px dashed rgba(44, 42, 38, 0.18);
}

.start-orbit::before {
    content: "";
    position: absolute;
    inset: 1.35rem;
    border-radius: 50%;
    border: 1px solid rgba(44, 42, 38, 0.08);
}

.start-core {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 7.25rem;
    height: 7.25rem;
    transform: translate(-50%, -50%);
    border-radius: 24px;
    background: linear-gradient(145deg, rgba(74, 124, 89, 0.88), rgba(91, 143, 168, 0.82));
    box-shadow: 0 18px 44px rgba(74, 124, 89, 0.22);
}

.start-core::before,
.start-core::after {
    content: "";
    position: absolute;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.34);
}

.start-core::before {
    inset: 0.8rem;
}

.start-core::after {
