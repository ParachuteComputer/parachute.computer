    height: 14rem;
    border-radius: 42% 58% 51% 49% / 46% 41% 59% 54%;
    background: rgba(91, 143, 168, 0.18);
    animation: startFloat 9s ease-in-out infinite;
}

.start-orbit {
    position: absolute;
    inset: 50% auto auto 50%;
