<script>
(function () {
    var media = document.querySelectorAll("[data-parallax]");
    if (!media.length || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    function updateParallax(el) {
        var rect = el.getBoundingClientRect();
        var viewport = window.innerHeight || document.documentElement.clientHeight;
        var progress = (rect.top + rect.height / 2 - viewport / 2) / viewport;
        var kind = el.getAttribute("data-parallax");

        if (kind === "launch") {
            el.style.setProperty("--launch-parallax-shift", (progress * -24).toFixed(2) + "px");
            return;
        }

        el.style.setProperty("--parallax-shift", (progress * -36).toFixed(2) + "px");
    }

    function updateAll() {
        media.forEach(updateParallax);
    }

    updateAll();
    window.addEventListener("scroll", updateAll, { passive: true });
    window.addEventListener("resize", updateAll);
})();

(function () {
    var container = document.querySelector("[data-rotating-message]");
    if (!container) return;

