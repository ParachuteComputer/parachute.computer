    var messages = [
        "Hey, Parachute... help me sketch a better week from the notes I already have.",
        "Hey, Parachute... pull together everything I said about hosting for friends and family.",
        "Hey, Parachute... turn these scattered ideas into a cleaner plan I can share.",
        "Hey, Parachute... show me what changed this week and what still needs attention.",
        "Hey, Parachute... draft a simple update from the work that shipped most recently."
    ];

    var current = 0;
    var node = container.querySelector("p");
    if (!node) return;

    function swapMessage() {
        current = (current + 1) % messages.length;

        if (prefersReduced) {
            node.textContent = messages[current];
            return;
        }

        node.classList.add("is-exiting");

        window.setTimeout(function () {
            node.textContent = messages[current];
            node.classList.remove("is-exiting");
            node.classList.add("is-entering");

            window.requestAnimationFrame(function () {
                window.requestAnimationFrame(function () {
                    node.classList.remove("is-entering");
                });
            });
        }, 320);
    }

    window.setInterval(swapMessage, 4200);
})();

(function () {
    var svg = document.querySelector("[data-community-graph]");
    if (!svg) return;

    var prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var ns = "http://www.w3.org/2000/svg";
    var width = 320;
    var height = 320;
    var centerX = width / 2;
    var centerY = height / 2;
    var frame = 0;
    var growthEvery = 240;
    var jitterEvery = 720;
    var initialCount = prefersReduced ? 22 : 8;
    var activeCount = initialCount;

    var linkLayer = document.createElementNS(ns, "g");
    var nodeLayer = document.createElementNS(ns, "g");
    svg.appendChild(linkLayer);
    svg.appendChild(nodeLayer);

    function buildNode(index, total) {
        var ring = 44 + (index / total) * 82;
        var angle = index * 2.3999632297;
        var x = centerX + Math.cos(angle) * ring;
        var y = centerY + Math.sin(angle) * ring * 0.88;
        return {
            x: x,
            y: y,
            r: index % 9 === 0 ? 7.5 : index % 5 === 0 ? 6.5 : 5.4,
            ampX: 5 + (index % 6) * 1.5,
            ampY: 5 + (index % 5) * 1.7,
            speed: 0.0038 + (index % 7) * 0.00038,
            phase: index * 0.73,
            kind: index % 11 === 0 ? "accent" : index % 4 === 0 ? "muted" : "base"
        };
    }

    function buildNodes(total) {
        var arr = [];
        for (var i = 0; i < total; i += 1) arr.push(buildNode(i, total));
        return arr;
    }

    var nodes = buildNodes(52);

    function buildLinks(nodeCount) {
        var output = [];
        for (var i = 1; i < nodeCount; i += 1) {
            var parent = Math.max(0, i - (2 + (i % 5)));
            output.push([i, parent]);
            if (i > 6 && i % 3 === 0) output.push([i, Math.max(0, i - 6)]);
            if (i > 10 && i % 5 === 0) output.push([i, Math.max(0, i - 11)]);
        }
        return output;
    }

    var links = buildLinks(nodes.length);

    function jitterNode(node) {
        node.phase = Math.random() * Math.PI * 2;
        node.ampX = 4 + Math.random() * 8;
        node.ampY = 4 + Math.random() * 8;
        node.speed = 0.0035 + Math.random() * 0.0018;
    }

    var linkEls = links.map(function () {
        var line = document.createElementNS(ns, "line");
        line.setAttribute("class", "graph-link");
        linkLayer.appendChild(line);
        return line;
    });

    var nodeEls = nodes.map(function (node) {
        var circle = document.createElementNS(ns, "circle");
        var className = "graph-node";
        if (node.kind === "muted") className += " graph-node-muted";
        if (node.kind === "accent") className += " graph-node-accent";
        circle.setAttribute("class", className);
        circle.setAttribute("r", node.r);
        nodeLayer.appendChild(circle);
        return circle;
    });

    function setVisible(el, visible) {
        el.style.opacity = visible ? "1" : "0";
    }

    function positionFor(node, t) {
        var angle = node.phase + t * node.speed;
        var radial = 1 + 0.08 * Math.sin(t * node.speed * 0.7 + node.phase);
        return {
            x: centerX + (node.x - centerX) * radial + Math.cos(angle) * node.ampX,
            y: centerY + (node.y - centerY) * radial + Math.sin(angle * 1.15) * node.ampY
        };
    }

    function draw() {
        var t = frame;
        var positions = nodes.map(function (node) { return positionFor(node, t); });

        linkEls.forEach(function (line, i) {
            var sourceIndex = links[i][0];
            var targetIndex = links[i][1];
            var visible = sourceIndex < activeCount && targetIndex < activeCount;
            setVisible(line, visible);
            if (!visible) return;
            var a = positions[sourceIndex];
            var b = positions[targetIndex];
            line.setAttribute("x1", a.x.toFixed(2));
            line.setAttribute("y1", a.y.toFixed(2));
            line.setAttribute("x2", b.x.toFixed(2));
            line.setAttribute("y2", b.y.toFixed(2));
        });

        nodeEls.forEach(function (circle, i) {
            var visible = i < activeCount;
            setVisible(circle, visible);
            if (!visible) return;
            var p = positions[i];
            circle.setAttribute("cx", p.x.toFixed(2));
            circle.setAttribute("cy", p.y.toFixed(2));
        });
    }

    function tick() {
        if (!prefersReduced) {
            frame += 1;
            if (frame % growthEvery === 0 && activeCount < nodes.length) {
                activeCount += 1;
                jitterNode(nodes[activeCount - 1]);
            }
            if (frame % jitterEvery === 0) {
                jitterNode(nodes[(frame / jitterEvery) % activeCount]);
            }
        }
        draw();
        window.requestAnimationFrame(tick);
    }

    draw();
    window.requestAnimationFrame(tick);
})();
</script>
