<div class="doors">
    {% for dp in doorPages %}
    <section>
        <h2><a href="/docs/{{ dp.door }}/">{{ dp.name }}</a></h2>
        <p class="who">{{ dp.short }}</p>
        <ol>
            {% for p in collections.docs | door(dp.door) %}
            <li><div><a href="{{ p.url }}">{{ p.data.nav or p.data.title }}</a><span>{{ p.data.summary | inlineCode | safe }}</span></div></li>
            {% endfor %}
        </ol>
    </section>
    {% endfor %}
</div>
