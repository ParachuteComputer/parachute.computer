{% set who = { use: ["Use", "For people: get the app, connect your AI, your home."], build: ["Build", "For builders and their AI: types, records, applets, bundles."], run: ["Run", "For whoever keeps the server: Cloud or your own."] } %}
<div class="doors">
    {% for d in ["use", "build", "run"] %}
    <section>
        <h2><a href="/docs/{{ d }}/">{{ who[d][0] }}</a></h2>
        <p class="who">{{ who[d][1] }}</p>
        <ol>
            {% for p in collections.docs | door(d) %}
            <li><div><a href="{{ p.url }}">{{ p.data.nav or p.data.title }}</a><span>{{ p.data.summary }}</span></div></li>
            {% endfor %}
        </ol>
    </section>
    {% endfor %}
</div>
