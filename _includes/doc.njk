---
layout: base.njk
---
{# A docs page: the contents beside it, the page, and how to read it as markdown. #}
<div class="docs">
    <nav class="toc" aria-label="Docs">
        <details id="toc"><summary>Contents</summary>
        {% for dp in doorPages %}
        <h2><a href="/docs/{{ dp.door }}/" {% if dp.door == door %}class="door-here"{% endif %}>{{ dp.label }}</a></h2>
        <ol>
            {% for p in collections.docs | door(dp.door) %}
            <li><a href="{{ p.url }}" {% if p.url == page.url %}aria-current="page"{% endif %}>{{ p.data.nav or p.data.title }}</a></li>
            {% endfor %}
        </ol>
        {% endfor %}
        </details>
    </nav>
    {# Open beside the page on a wide screen; on a phone, one line above it. #}
    <script>if (matchMedia("(min-width: 861px)").matches) document.getElementById("toc").open = true;</script>
    <article class="doc">
        {% for dp in doorPages %}{% if dp.door == door %}<p class="door-label">{{ dp.label }}</p>{% endif %}{% endfor %}
        <h1>{{ title }}</h1>
        <p class="summary">{{ summary | inlineCode | safe }}</p>
        {% if status and status != "current" %}<p class="status"><b>{{ "Next release" if status == "next" else "Coming" }}:</b> {{ status_note }}</p>{% endif %}
        {{ content | safe }}
        <p class="page-foot">
            This page as markdown, for your AI: <a href="/docs/{{ slug }}.md">/docs/{{ slug }}.md</a>. Every page: <a href="/llms.txt">/llms.txt</a>.
            {% if checked %}<br>Checked against the code: {{ checked }}.{% endif %}
            <br><a href="https://github.com/ParachuteComputer/parachute.computer/blob/main/docs/{{ slug }}.md">Edit this page</a>
        </p>
    </article>
</div>
