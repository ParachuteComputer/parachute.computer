<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}{% if title %} | {% endif %}Parachute Computer</title>
    <meta name="description" content="{{ description or 'The note-taking system you have been looking for. An open knowledge layer for humans and AI to think and remember together.' }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/style.css">
    <link rel="icon" href="/assets/parachute-logo.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png">
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#4a7c59">

    {# Open Graph / share-preview metadata. Posts can override via
       frontmatter: og_title, og_description, og_image, og_type. #}
    {% set _ogTitle = og_title or title %}
    {% set _ogDescription = og_description or description or "The note-taking system you have been looking for. An open knowledge layer for humans and AI to think and remember together." %}
    {% set _ogImage = og_image or "/assets/og-default.jpg" %}
    {% set _ogType = og_type or "website" %}
    {% set _canonicalUrl = "https://parachute.computer" + (page.url or "/") %}

    <meta property="og:site_name" content="Parachute Computer">
    <meta property="og:title" content="{{ _ogTitle }}{% if _ogTitle %} | {% endif %}Parachute Computer">
    <meta property="og:description" content="{{ _ogDescription }}">
    <meta property="og:type" content="{{ _ogType }}">
    <meta property="og:url" content="{{ _canonicalUrl }}">
    <meta property="og:image" content="https://parachute.computer{{ _ogImage }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="A parachute descending over open plains at dawn, its canopy woven with a luminous knowledge graph.">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ _ogTitle }}{% if _ogTitle %} | {% endif %}Parachute Computer">
    <meta name="twitter:description" content="{{ _ogDescription }}">
    <meta name="twitter:image" content="https://parachute.computer{{ _ogImage }}">
    <meta name="twitter:image:alt" content="A parachute descending over open plains at dawn, its canopy woven with a luminous knowledge graph.">

    <link rel="canonical" href="{{ _canonicalUrl }}">
</head>
<body>
    <header>
        <nav>
            <a href="/" class="logo">
                <img src="/assets/parachute-logo.svg" alt="" class="logo-mark" aria-hidden="true">
                <span class="logo-text">Parachute Computer</span>
            </a>
            <div class="nav-links">
                <a href="/install/">Install</a>
                <a href="/blog/">Blog</a>
                <a href="/docs/">Docs</a>
                <a href="/roadmap/">Roadmap</a>
                <a href="https://github.com/ParachuteComputer" target="_blank">GitHub</a>
            </div>
        </nav>
    </header>

    {{ content | safe }}

    <footer>
        <p>&copy; 2026 Open Parachute, PBC</p>
        <p>A Colorado Public Benefit Corporation building open tools for thinking.</p>
        <p style="margin-top: 0.75rem;"><a href="/install/">Install</a> &middot; <a href="/blog/">Blog</a> &middot; <a href="/docs/">Docs</a> &middot; <a href="/roadmap/">Roadmap</a> &middot; <a href="/since-launch/">Since launch</a> &middot; <a href="https://github.com/ParachuteComputer" target="_blank">GitHub</a></p>
    </footer>
</body>
</html>
