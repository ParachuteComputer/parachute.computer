<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}{% if title %} | {% endif %}Parachute Computer</title>
    <meta name="description" content="{{ description or 'You and AI, thinking together. An open, self-hosted memory you and any AI can read and write — on your machine, yours to keep and export anytime.' }}">
    {# Internal design notes (design/*.md set noindex) stay reachable via deep links
       but are kept out of search results — they're working material, not polished docs. #}
    {% if noindex %}<meta name="robots" content="noindex">{% endif %}
    {# Fonts are system stacks (see style.css :root) — no webfont download. #}
    <link rel="stylesheet" href="/style.css">
    <link rel="icon" href="/assets/parachute-favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png">
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#fdfaf4">

    {# Open Graph / share-preview metadata. Posts can override via
       frontmatter: og_title, og_description, og_image, og_type. #}
    {% set _ogTitle = og_title or title %}
    {% set _ogDescription = og_description or description or "You and AI, thinking together. An open, self-hosted memory you and any AI can read and write — on your machine, yours to keep and export anytime." %}
    {% set _ogImage = og_image or "/og.png" %}
    {% set _ogType = og_type or "website" %}
    {% set _canonicalUrl = "https://parachute.computer" + (page.url or "/") %}

    <meta property="og:site_name" content="Parachute Computer">
    <meta property="og:title" content="{{ _ogTitle }}{% if _ogTitle %} | {% endif %}Parachute Computer">
    <meta property="og:description" content="{{ _ogDescription }}">
    <meta property="og:type" content="{{ _ogType }}">
    <meta property="og:url" content="{{ _canonicalUrl }}">
    <meta property="og:image" content="https://parachute.computer{{ _ogImage }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="A hand-drawn parachute over the words: Parachute — a soft place for your thoughts to land.">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ _ogTitle }}{% if _ogTitle %} | {% endif %}Parachute Computer">
    <meta name="twitter:description" content="{{ _ogDescription }}">
    <meta name="twitter:image" content="https://parachute.computer{{ _ogImage }}">
    <meta name="twitter:image:alt" content="A hand-drawn parachute over the words: Parachute — a soft place for your thoughts to land.">

    <link rel="canonical" href="{{ _canonicalUrl }}">
</head>
<body>
    {# Custom open parachute mark — reused via <use> in the nav + footer.
       Same hand-drawn glyph as the homepage; colored by the .pc-* rules in
       style.css. NOT Apple's copyrighted parachute, NOT the old graph logo. #}
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <symbol id="pchute" viewBox="0 0 64 60">
        <path class="pc-canopy" d="M4 28 A28 28 0 0 1 60 28 Q54 37 46 28 Q39 37 32 28 Q25 37 18 28 Q10 37 4 28 Z"/>
        <g class="pc-gore">
          <path d="M32 2.2 Q31.5 15 32 27.6"/>
          <path d="M32 3 Q20 14 18 27.6"/>
          <path d="M32 3 Q44 14 46 27.6"/>
          <path d="M32 4 Q9.5 15 4.4 27.6"/>
          <path d="M32 4 Q54.5 15 59.6 27.6"/>
        </g>
        <g class="pc-string">
          <path d="M5 28 L31 47"/>
          <path d="M18 30 L31 47"/>
          <path d="M32 30 L32 47"/>
          <path d="M46 30 L33 47"/>
          <path d="M59 28 L33 47"/>
        </g>
        <rect class="pc-load" x="26.5" y="46.5" width="11" height="10" rx="3.5"/>
        <rect class="pc-load-ring" x="28.6" y="48.6" width="6.8" height="5.8" rx="2"/>
      </symbol>
    </svg>

    <header class="site-nav">
        <div class="nav-in">
            <a class="brand" href="/" aria-label="Parachute — home">
                <svg class="mark" aria-hidden="true"><use href="#pchute"/></svg>
                <span>Parachute</span>
            </a>
            {# One canonical, flat nav — identical to the homepage (landing-preview.html).
               Kept lean on purpose: Pricing (the paid door), Blog (news), Self-host
               (the free door), GitHub (open source), and the primary CTA. The product
               ladder (Vault/Surfaces/Agents/Modules), Guides, and Docs live in the
               footer — the header is for the few things a first-time visitor needs. #}
            <nav class="nav-right">
                <a class="nav-drop" href="/pricing/">Pricing</a>
                <a class="nav-drop" href="/blog/">Blog</a>
                <a class="selfhost" href="/start/">Self-host</a>
                <a class="nav-drop" href="https://github.com/ParachuteComputer" target="_blank" rel="noopener">GitHub</a>
                <a class="btn btn-primary" href="https://cloud.parachute.computer/signup">Get a vault</a>
            </nav>
        </div>
    </header>

    {{ content | safe }}

    <footer class="site-footer">
        <div class="foot-brand"><svg class="mark" aria-hidden="true"><use href="#pchute"/></svg><span>Parachute</span></div>
        <p class="foot-tag">Your digital life needs a safe place to land.</p>
        <nav class="foot-links">
            <a href="https://cloud.parachute.computer/signup">Get a vault</a>
            <a href="/pricing/">Pricing</a>
            <a href="/start/">Self-host</a>
            <a href="/vault/">Vault</a>
            <a href="/surfaces/">Surfaces</a>
            <a href="/agents/">Agents</a>
            <a href="/modules/">Modules</a>
            <a href="/guides/">Guides</a>
            <a href="/blog/">Blog</a>
            <a href="/docs/">Docs</a>
            <a href="https://github.com/ParachuteComputer" target="_blank" rel="noopener">GitHub</a>
        </nav>
        <p class="foot-fine">&copy; 2026 Open Parachute, PBC &mdash; a Colorado Public Benefit Corporation building open tools for thinking.</p>
        <p class="foot-fine"><a href="/terms/">Terms</a> &middot; <a href="/privacy/">Privacy</a></p>
    </footer>

    {# Copy-to-clipboard — progressive enhancement. With JS off, no button
       is added and every code block stays plain, fully selectable text.
       Targets command blocks (.code-inline) and rendered fenced-code
       prompt blocks (.post-content pre). Opt out with data-no-copy. #}
    <script>
    (function () {
        if (!navigator.clipboard) return;

        function addButton(el, label) {
            if (el.dataset.copyReady) return;
            el.dataset.copyReady = "1";
            el.classList.add("copy-wrap");

            var btn = document.createElement("button");
            btn.type = "button";
            btn.className = "copy-btn";
            btn.textContent = label;
            var resetLabel = label;
            var timer;

            btn.addEventListener("click", function () {
                // Copy the code text only, never the button label.
                var source = el.querySelector("code") || el;
                var text = source === el
                    ? Array.prototype.filter
                        .call(el.childNodes, function (n) { return n !== btn; })
                        .map(function (n) { return n.textContent; })
                        .join("")
                    : source.textContent;
                navigator.clipboard.writeText(text.trim()).then(function () {
                    btn.textContent = "Copied";
                    btn.classList.add("copied");
                    clearTimeout(timer);
                    timer = setTimeout(function () {
                        btn.textContent = resetLabel;
                        btn.classList.remove("copied");
                    }, 1600);
                });
            });

            el.appendChild(btn);
        }

        // Command blocks on install / docs pages.
        document.querySelectorAll(".code-inline:not([data-no-copy])").forEach(function (el) {
            addButton(el, "Copy");
        });

        // Rendered fenced-code prompt blocks on the onboarding pages
        // (and any other markdown post). "Copy prompt" reads right for
        // the big starter-prompt blocks and is harmless elsewhere.
        document.querySelectorAll(".post-content pre:not([data-no-copy])").forEach(function (el) {
            addButton(el, "Copy prompt");
        });
    })();
    </script>

</body>
</html>
